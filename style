:root{--bg:#dfe9d6;--panel:#fffaf0;--ink:#2b1d14;--mut:#6b5a4a;--acc:#e0a11b;--good:#2f8f2f;--bad:#c4412f;--line:#2b1d14;--bar:#cdbd9c;--map:#b9d6a0;--forest:#5e9a4c;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#16251d;--panel:#33261c;--ink:#f3e9d2;--mut:#bba98f;--acc:#f2b632;--good:#7bd46a;--bad:#ef6a5b;--line:#0b120e;--bar:#1d140e;--map:#22382b;--forest:#16301f}}
:root[data-theme="dark"]{--bg:#16251d;--panel:#33261c;--ink:#f3e9d2;--mut:#bba98f;--acc:#f2b632;--good:#7bd46a;--bad:#ef6a5b;--line:#0b120e;--bar:#1d140e;--map:#22382b;--forest:#16301f}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:600 15px/1.4 Nunito,system-ui,sans-serif}
h1,h2,.hd{font-family:Bangers,Impact,sans-serif;letter-spacing:.04em;font-weight:400;margin:0;color:var(--ink)}
h1{font-size:24px}h2{font-size:22px;margin:4px 0 8px}
#top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);padding:8px 10px 6px;border-bottom:3px solid var(--line)}
.r1,.r2,.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.r1{justify-content:space-between}
.pill{border:3px solid var(--line);border-radius:999px;background:var(--panel);padding:2px 10px;font-weight:800;font-size:13px}
.r2{margin:5px 0;justify-content:space-between;flex-wrap:nowrap}
.res{flex:1;text-align:center;border:3px solid var(--line);border-radius:10px;background:var(--panel);padding:2px 4px;font-weight:800;font-size:14px}
.sv .bar{flex:1;height:10px;margin:0}
.xp,.qr{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;margin-top:4px}
.xp .bar,.qr .bar{flex:1;height:10px;margin:0}.xp span{white-space:nowrap}.qr span{white-space:nowrap;max-width:55%;overflow:hidden;text-overflow:ellipsis}
.warn{background:var(--bad);color:#fff;border:3px solid var(--line);border-radius:8px;padding:2px 8px;font-weight:800;font-size:13px;margin:4px 0}
#tabs{display:flex;gap:4px}
#tabs button{flex:1;padding:5px 0;font:inherit;font-size:12px;color:var(--ink);background:var(--panel);border:3px solid var(--line);border-radius:8px;cursor:pointer}
#tabs button.on{background:var(--acc);color:#2b1d14}
main{padding:12px 10px 100px;max-width:640px;margin:0 auto}
.card{background:var(--panel);border:3px solid var(--line);border-radius:14px;box-shadow:4px 4px 0 var(--line);padding:10px;margin-bottom:12px}
.card p{margin:2px 0;color:var(--mut);font-size:13px}.card .e,p.e{color:var(--good);font-weight:800}
.ic{font-size:28px}.g{flex:1;min-width:0}
.ch{border:2px solid var(--line);border-radius:999px;padding:0 8px;font-size:12px;font-weight:800;background:var(--bar);color:var(--ink)}
.t{font-size:12px;color:var(--mut)}
button.b{margin-left:auto;font:400 18px Bangers,Impact,sans-serif;letter-spacing:.05em;background:var(--acc);color:#2b1d14;border:3px solid var(--line);border-radius:8px;padding:3px 12px;cursor:pointer;box-shadow:2px 2px 0 var(--line)}
button.b.s{margin:0}.b.on{background:var(--good);color:#fff}
button.b:active{transform:translate(2px,2px);box-shadow:none}
button.b:disabled{opacity:.45;cursor:not-allowed}
button:focus-visible,input:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.bar{height:14px;border:3px solid var(--line);border-radius:7px;background:var(--bar);overflow:hidden;margin:4px 0}
.bar i{display:block;height:100%;background:var(--good);transition:width .4s}
.bar.x i{background:var(--acc)}.bw i{background:#3f8fd8}.bf i{background:#e08a3a}.be i{background:var(--good)}.bm i{background:#e0583a}
.log p{margin:0 0 8px;color:var(--ink);font-size:14px}
input[type=text]{font:inherit;width:100%;padding:8px;border:3px solid var(--line);border-radius:8px;background:var(--panel);color:var(--ink);margin:8px 0}
input[type=range]{width:100%;accent-color:var(--acc)}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(16px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);border-radius:999px;padding:8px 16px;font-weight:800;max-width:80%;text-align:center;opacity:0;pointer-events:none;transition:opacity .25s;z-index:30}
#toast.on{opacity:1}
#tip{position:fixed;left:12px;right:12px;bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:40;max-width:420px;margin:0 auto;background:var(--panel);color:var(--ink);border:3px solid var(--line);border-radius:14px;box-shadow:4px 4px 0 var(--line);padding:10px 12px;font-size:14px}
#tip[hidden]{display:none}
.tb{position:relative;height:32px;border:3px solid var(--line);border-radius:10px;background:var(--bar);overflow:hidden;margin:6px 0;flex:1 1 100%;box-shadow:2px 2px 0 var(--line)}
.tb i{position:absolute;left:0;top:0;bottom:0;width:0;background:repeating-linear-gradient(45deg,var(--acc) 0 12px,#f7cd62 12px 24px);transition:width .5s linear}
.tb.g i{background:repeating-linear-gradient(45deg,#2f9e44 0 12px,#58c46a 12px 24px)}
.tb.b i{background:repeating-linear-gradient(45deg,#2f78c4 0 12px,#58a2ea 12px 24px)}
.tb.r i{background:repeating-linear-gradient(45deg,#c4412f 0 12px,#ea6a58 12px 24px)}
.tb.o i{background:repeating-linear-gradient(45deg,#d9731a 0 12px,#f39a46 12px 24px)}
.tb span{position:relative;display:block;text-align:center;line-height:26px;padding:0 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font:400 18px/26px Bangers,Impact,sans-serif;letter-spacing:.05em;color:#fff;text-shadow:-1px -1px 0 #000,1px -1px 0 #000,-1px 1px 0 #000,1px 1px 0 #000,0 2px 0 #000}
.tb.c{height:24px;margin:3px 0}.tb.c span{font-size:14px;line-height:18px}
#tm{margin-top:4px}
.army{font-size:12px;font-weight:800;margin-top:4px}
#modal{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:20;display:flex;align-items:center;justify-content:center;padding:20px}
#modal[hidden],#invp[hidden]{display:none}
.mbox{background:var(--panel);border:4px solid var(--line);border-radius:18px;box-shadow:6px 6px 0 var(--line);padding:20px;text-align:center;max-width:340px;width:100%}
.big{font-size:72px;line-height:1.2}
.pop{animation:pop .6s cubic-bezier(.3,1.6,.5,1)}
@keyframes pop{from{transform:scale(.2) rotate(-25deg);opacity:0}to{transform:none;opacity:1}}
#invp{position:fixed;inset:0;z-index:12;background:var(--bg);overflow:auto;padding:calc(12px + env(safe-area-inset-top,0px)) 10px calc(80px + env(safe-area-inset-bottom,0px))}
#invp>*{max-width:640px;margin-left:auto;margin-right:auto}
#invbtn{position:fixed;right:12px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:9;width:54px;height:54px;border-radius:50%;font-size:26px;background:var(--acc);border:3px solid var(--line);cursor:pointer;box-shadow:3px 3px 0 var(--line)}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
